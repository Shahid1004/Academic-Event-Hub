# Use the SRV URI copied from MongoDB Atlas, including the database name.
MONGO_URI=mongodb+srv://username:password@cluster.example.mongodb.net/academic_event_hub?retryWrites=true&w=majority
PORT=5000
JWT_SECRET=replace_with_a_long_random_secret
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your_smtp_user
SMTP_PASSWORD=your_smtp_app_password
SMTP_FROM=Academic Event Hub <no-reply@example.com>

# AI Engine API Keys
GEMINI_API_KEY=your_gemini_api_key_here
OPENAI_API_KEY=your_openai_api_key_here

# Microsoft Entra App Registration & OneDrive Configuration
# Delegated Permissions configured: User.Read, Files.ReadWrite
MICROSOFT_CLIENT_ID=your_microsoft_entra_app_client_id_here
MICROSOFT_CLIENT_SECRET=your_microsoft_entra_app_client_secret_here
MICROSOFT_TENANT_ID=common
MICROSOFT_REDIRECT_URI=http://localhost:5000/api/onedrive/auth/callback
# Optional: Pre-seeded refresh token (if obtained externally or from offline consent)
# MICROSOFT_REFRESH_TOKEN=your_refresh_token_here